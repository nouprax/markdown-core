    "values": {
        "Destination": {
            "purpose": "A tagged value, not a node: it has no id, extent, children, anchor, or attributes, and a branch's fields exist only in that branch. Every Link and Embedded owns the url branch; the cross branch is the workspace address CrossLink and CrossEmbedded produce.",
            "branches": {
                "url": [
                    {
                        "name": "value",
                        "type": "String",
                        "optional": false
                    }
                ],
                "cross": [
                    {
                        "name": "path",
                        "type": "String",
                        "optional": false
                    },
                    {
                        "name": "anchor",
                        "type": "String",
                        "optional": true
                    }
                ]
            },
            "dump": "url(\"...\") or cross(path=\"...\",anchor=null)"
        },
        "CitationReferent": {
            "purpose": "A tagged value, not a node: it has no id or extent, and a branch's fields exist only in that branch. The bib branch is produced by bibliography citations; every referenced or inline footnote call produces the footnote branch. Its label target names the first Footnote in document source order whose label is equal, and its note target owns an inline note's Footnote. The specimen branch names the first Specimen in document source order whose label is equal.",
            "branches": {
                "bib": [
                    {
                        "name": "key",
                        "type": "String",
                        "optional": false
                    },
                    {
                        "name": "mode",
                        "type": "BibMode",
                        "optional": false
                    }
                ],
                "footnote": [
                    {
                        "name": "target",
                        "type": "FootnoteTarget",
                        "optional": false
                    }
                ],
                "specimen": [
                    {
                        "name": "label",
                        "type": "String",
                        "optional": false
                    }
                ]
            },
            "dump": "bib(key=\"...\",mode=normal) or footnote(label=\"...\") or footnote(note) or specimen(label=\"...\")"
        },
        "FootnoteTarget": {
            "purpose": "The footnote a footnote referent names: a label looked up in the document, or the inline note's Footnote, which the referent owns.",
            "branches": {
                "label": [
                    {
                        "name": "value",
                        "type": "String",
                        "optional": false
                    }
                ],
                "note": [
                    {
                        "name": "footnote",
                        "type": "Footnote",
                        "optional": false
                    }
                ]
            },
            "dump": "label=\"...\" or note within the footnote referent; the note's Footnote nests under its Citation before the affix groups"
        },
        "OrderedListDelimiter": {
            "purpose": "The authored punctuation of an ordered marker: a period, parenthesis punctuation recording whether an opening parenthesis was authored, or the default marker form.",
            "scoped": false,
            "branches": [
                {
                    "name": "period",
                    "fields": []
                },
                {
                    "name": "parenthesis",
                    "fields": [
                        {
                            "name": "closed",
                            "type": "Bool",
                            "optional": false
                        }
                    ]
                },
                {
                    "name": "default",
                    "fields": []
                }
            ],
            "dump": "period, parenthesis(closed=true|false), or default"
        },
        "OrderedListVariant": {
            "purpose": "The authored numbering system of an ordered marker, with authored case carried by alphabetic and Roman variants.",
            "scoped": false,
            "branches": [
                {
                    "name": "decimal",
                    "fields": []
                },
                {
                    "name": "alpha",
                    "fields": [
                        {
                            "name": "lowercased",
                            "type": "Bool",
                            "optional": false
                        }
                    ]
                },
                {
                    "name": "roman",
                    "fields": [
                        {
                            "name": "lowercased",
                            "type": "Bool",
                            "optional": false
                        }
                    ]
                },
                {
                    "name": "default",
                    "fields": []
                }
            ],
            "dump": "decimal, alpha(lowercased=true|false), roman(lowercased=true|false), or default"
