{
    "schemaVersion": 1,
    "purpose": "The machine-readable, normative canonical AST contract. C, Swift, Kotlin, and TypeScript declare projections of this shape, and scripts/audit-ast-projections.mjs checks every projection plus the prose and debug-dump tables against this file. Formula is the only kind whose placement mode varies; placement for Code, CodeBlock, Directive, DirectiveBlock, and FormulaBlock is implied by the kind.",
    "prose": "docs/specs/canonical-ast.md",
    "dumpGrammar": "docs/specs/canonical-ast-dump.md",
    "enums": {
        "PlacementMode": ["embedded", "standalone"],
        "ListFlavor": ["bullet", "ordered"],
        "ReferenceForm": ["full", "collapsed", "shortcut"],
        "TableAlignment": ["none", "left", "center", "right"],
        "DirectiveAttribute": "a name/value pair of Strings"
    },
    "inheritedField": {
        "name": "scope",
        "type": "Scope",
        "optional": false
    },
    "kinds": [
        {
            "name": "Document",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "block content"
        },
        {
            "name": "BlockQuote",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "block content"
        },
        {
            "name": "Paragraph",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "Heading",
            "fields": [
                {
                    "name": "level",
                    "type": "Int",
                    "optional": false
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "`level` is 1 through 6; inline content"
        },
        {
            "name": "ThematicBreak",
            "fields": [],
            "invariants": "leaf"
        },
        {
            "name": "List",
            "fields": [
                {
                    "name": "flavor",
                    "type": "ListFlavor",
                    "optional": false
                },
                {
                    "name": "start",
                    "type": "Int",
                    "optional": true
                },
                {
                    "name": "tight",
                    "type": "Bool",
                    "optional": false
                },
                {
                    "name": "items",
                    "type": "[ListItem]",
                    "optional": false
                }
            ],
            "invariants": "`start` is non-null only for ordered lists"
        },
        {
            "name": "ListItem",
            "fields": [
                {
                    "name": "checked",
                    "type": "Bool",
                    "optional": true
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "`checked == null` means not a task item; block content"
        },
        {
            "name": "CodeBlock",
            "fields": [
                {
                    "name": "info",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "language",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "fenced",
                    "type": "Bool",
                    "optional": false
                },
                {
                    "name": "closed",
                    "type": "Bool",
                    "optional": false
                }
            ],
            "invariants": "mode is `standalone`; `info` is the complete raw info string; `language` is its first non-whitespace token; indented blocks have `fenced=false, closed=true`"
        },
        {
            "name": "HTMLBlock",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "raw HTML is preserved"
        },
        {
            "name": "FormulaBlock",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "mode is `standalone`"
        },
        {
            "name": "Table",
            "fields": [
                {
                    "name": "alignments",
                    "type": "[TableAlignment]",
                    "optional": false
                },
                {
                    "name": "header",
                    "type": "TableRow",
                    "optional": false
                },
                {
                    "name": "rows",
                    "type": "[TableRow]",
                    "optional": false
                }
            ],
            "invariants": "one alignment per column; header is non-optional"
        },
        {
            "name": "TableRow",
            "fields": [
                {
                    "name": "isHeader",
                    "type": "Bool",
                    "optional": false
                },
                {
                    "name": "cells",
                    "type": "[TableCell]",
                    "optional": false
                }
            ],
            "invariants": "`isHeader` is true only for `Table.header` and false for entries in `Table.rows`"
        },
        {
            "name": "TableCell",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "DirectiveBlock",
            "fields": [
                {
                    "name": "name",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "attributes",
                    "type": "[DirectiveAttribute]",
                    "optional": true
                },
                {
                    "name": "label",
                    "type": "DirectiveLabel",
                    "optional": true
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "attributes is an ordered sequence of name/value pairs sorted by name; label is a node-valued field whose scope spans its brackets and is never part of content; content is block; an absent attribute container and an empty one remain distinct, as do an absent label and an empty one"
        },
        {
            "name": "DirectiveLabel",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content; the scope spans the brackets, so an empty label is still a place"
        },
        {
            "name": "FootnoteDefinition",
            "fields": [
                {
                    "name": "label",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "identifier",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "label is non-empty and as written; identifier KEEPS the leading `^`, so a footnote and a link definition of one name cannot collide; block content"
        },
        {
            "name": "ReferenceDefinition",
            "fields": [
                {
                    "name": "label",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "identifier",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "destination",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "title",
                    "type": "String",
                    "optional": true
                }
            ],
            "invariants": "label is the bytes between the brackets as written, delimiters excluded, escapes and character references unresolved, whitespace uncollapsed, case unfolded; identifier is the match key -- full Unicode case fold, trimmed, internal whitespace collapsed -- and is compared with memcmp over its bytes; neither derives the other; destination is never absent, because a definition that could not build one is not produced at all; absent and empty title remain distinct; leaf"
        },
        {
            "name": "Text",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "leaf"
        },
        {
            "name": "SoftBreak",
            "fields": [],
            "invariants": "leaf"
        },
        {
            "name": "LineBreak",
            "fields": [],
            "invariants": "leaf"
        },
        {
            "name": "Code",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "mode is `embedded`; leaf"
        },
        {
