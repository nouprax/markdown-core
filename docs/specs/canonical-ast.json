{
    "schemaVersion": 1,
    "purpose": "The machine-readable, normative canonical AST contract. C, Swift, Kotlin, and TypeScript declare projections of this shape, and scripts/audit-ast-projections.mjs checks every projection plus the prose and debug-dump tables against this file. Formula is the only kind whose placement mode varies; placement for Code, CodeBlock, Directive, DirectiveBlock, and FormulaBlock is implied by the kind.",
    "prose": "docs/specs/canonical-ast.md",
    "dumpGrammar": "docs/specs/canonical-ast-dump.md",
    "walk": {
        "phases": ["entering", "exiting"],
        "order": "Depth first. A node enters, then its owned Markup-valued fields are visited in canonical field order with arrays retaining stored order, then the node exits. Relations remain named fields; the walk does not project them into generic children. Citation, Footnote, and Specimen receive their own entering/exiting callbacks and traverse their owned Markup fields. Metadata is a data value and emits no visitor callbacks. Document visits content, footnotes, specimens in that order."
    },
    "enums": {
        "Placement": ["embedded", "standalone"],
        "BibMode": ["normal", "authorInText", "suppressAuthor"],
        "ListFlavor": ["bullet", "ordered"],
        "TableAlignment": ["none", "left", "center", "right"]
    },
    "kinds": [
        {
            "name": "Document",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                },
                {
                    "name": "metadata",
                    "type": "Metadata",
                    "optional": true
                },
                {
                    "name": "footnotes",
                    "type": "[Footnote]",
                    "optional": false
                },
                {
                    "name": "specimens",
                    "type": "[Specimen]",
                    "optional": false
                }
            ],
            "invariants": "block content; document-owned footnotes and specimens each retain all definitions in scope-start order; visit content, then footnotes, then specimens; neither definition sequence counts as children"
        },
        {
            "name": "Callout",
            "fields": [
                {
                    "name": "variant",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "collapsed",
                    "type": "Bool",
                    "optional": true
                },
                {
                    "name": "title",
                    "type": "[Markup]",
                    "optional": true
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "every `>` container; `variant` is the authored type as written or null when the container has no metadata line, and then `collapsed` and `title` are null; `collapsed` is null when no `+` or `-` fold marker was authored, false for `+` and true for `-`; `title` is a node-valued field of inline content visited before `content` and never counted among its children; a present title holds at least one node; block content"
        },
        {
            "name": "Paragraph",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "Heading",
            "fields": [
                {
                    "name": "level",
                    "type": "Int",
                    "optional": false
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "`level` is 1 through 6; inline content"
        },
        {
            "name": "ThematicBreak",
            "fields": [],
            "invariants": "leaf"
        },
        {
            "name": "List",
            "fields": [
                {
                    "name": "flavor",
                    "type": "ListFlavor",
                    "optional": false
                },
                {
                    "name": "start",
                    "type": "Int",
                    "optional": true
                },
                {
                    "name": "variant",
                    "type": "OrderedListVariant",
                    "optional": true
                },
                {
                    "name": "delimiter",
                    "type": "OrderedListDelimiter",
                    "optional": true
                },
                {
                    "name": "tight",
                    "type": "Bool",
                    "optional": false
                },
                {
                    "name": "items",
                    "type": "[ListItem]",
                    "optional": false
                }
            ],
            "invariants": "`start` is non-null only for ordered lists"
        },
        {
            "name": "ListItem",
            "fields": [
                {
                    "name": "marker",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "`marker == null` means not a task item; block content"
        },
        {
            "name": "CodeBlock",
            "fields": [
                {
                    "name": "info",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "language",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "fenced",
                    "type": "Bool",
                    "optional": false
                },
                {
                    "name": "closed",
                    "type": "Bool",
                    "optional": false
                }
            ],
            "invariants": "mode is `standalone`; `info` is the complete raw info string; `language` is its first non-whitespace token; indented blocks have `fenced=false, closed=true`"
        },
        {
            "name": "HTMLBlock",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "raw HTML is preserved; a block that opens with `<!--` and whose end line holds only whitespace after the first `-->` is a `Comment`"
        },
        {
            "name": "FormulaBlock",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "mode is `standalone`"
        },
        {
            "name": "Table",
            "fields": [
                {
                    "name": "caption",
                    "type": "TableCaption",
                    "optional": true
                },
                {
                    "name": "columns",
                    "type": "[TableColumn]",
                    "optional": false
                },
                {
                    "name": "head",
                    "type": "[TableRow]",
                    "optional": false
                },
                {
                    "name": "content",
                    "type": "[TableRow]",
                    "optional": false
                },
                {
                    "name": "foot",
                    "type": "[TableRow]",
                    "optional": false
                }
            ],
            "invariants": "non-empty columns define the logical grid; rows are owned exactly once in head/content/foot order; pipe tables have one head row, no foot rows, null relative widths, and unit spans; no span crosses a group boundary"
        },
        {
            "name": "TableCaption",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "independently owned inline caption, visited before the table row groups"
        },
        {
            "name": "TableRow",
            "fields": [
                {
                    "name": "cells",
                    "type": "[TableCell]",
                    "optional": false
                }
            ],
            "invariants": "cells whose upper-left coordinate starts in this row, in logical order; no row-local header state"
        },
        {
            "name": "TableCell",
            "fields": [
                {
                    "name": "rowspan",
                    "type": "Int",
                    "optional": false
                },
                {
                    "name": "colspan",
                    "type": "Int",
                    "optional": false
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "positive spans; inline or block content is stored as parsed without paragraph normalization"
        },
        {
            "name": "DirectiveBlock",
            "fields": [
                {
                    "name": "name",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "label",
                    "type": "DirectiveLabel",
                    "optional": true
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "block content; name is null for a nameless container and required for a named leaf/container; nameless containers have no label; all container forms share the closer and nesting rules"
        },
        {
            "name": "DirectiveLabel",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content; the scope spans the brackets, so an empty label is still a place"
        },
        {
            "name": "Text",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "leaf"
        },
        {
            "name": "SoftBreak",
            "fields": [],
            "invariants": "leaf"
        },
        {
            "name": "LineBreak",
            "fields": [],
            "invariants": "leaf"
        },
        {
            "name": "Code",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "mode is `embedded`; leaf"
        },
        {
            "name": "HTML",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "raw HTML is preserved; an HTML comment token is a `Comment`; leaf"
        },
        {
            "name": "CrossLink",
            "fields": [
                {
                    "name": "dest",
                    "type": "Destination",
                    "optional": false
                },
                {
                    "name": "label",
                    "type": "String",
                    "optional": true
                }
            ],
            "invariants": "inline leaf; dest is cross(path, anchor); the complete raw label is null only when no separator was authored"
        },
        {
            "name": "CrossEmbedded",
            "fields": [
                {
                    "name": "dest",
                    "type": "Destination",
                    "optional": false
                },
                {
                    "name": "label",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "dimensions",
                    "type": "Dimensions",
                    "optional": true
                }
            ],
            "invariants": "inline leaf; workspace transclusion; dest is cross(path, anchor); label is the raw prefix after a valid dimension suffix and is null only when no separator was authored"
        },
        {
            "name": "Comment",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "the one kind valid in both block and inline content, which the parent edge records; `literal` excludes the delimiters and keeps every byte between them; leaf"
        },
        {
            "name": "Formula",
            "fields": [
                {
                    "name": "mode",
                    "type": "Placement",
                    "optional": false
                },
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "either mode; leaf"
        },
        {
            "name": "Emphasis",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "Strong",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "Strikethrough",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "Mark",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "Insertion",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "Span",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content; may be empty"
        },
        {
            "name": "Superscript",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content; non-empty body"
        },
        {
            "name": "Subscript",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content; non-empty body"
        },
        {
            "name": "Link",
            "fields": [
                {
                    "name": "dest",
                    "type": "Destination",
                    "optional": false
                },
                {
                    "name": "title",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "`dest` is the tagged `Destination` value and is never absent: `[a]()` and `[a](<>)` wrote one and wrote nothing in it, so it is `url(\"\")`; a reference occurrence answers the destination its definition stated, and an unresolved reference is the inherited literal text; every `Link` owns the `url` branch; absent and empty title remain distinct; inline content"
        },
        {
            "name": "Embedded",
            "fields": [
                {
                    "name": "dest",
                    "type": "Destination",
                    "optional": false
                },
                {
                    "name": "title",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "dimensions",
                    "type": "Dimensions",
                    "optional": true
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "`dest` is the tagged `Destination` value and is never absent, for the reason `Link.dest` is not; every `Embedded` owns the `url` branch; absent and empty title remain distinct; content is parsed alt-text inline content"
        },
        {
            "name": "Directive",
            "fields": [
                {
                    "name": "name",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "label",
                    "type": "DirectiveLabel",
                    "optional": true
                }
            ],
            "invariants": "letter-first name; attributes use the inherited fields; label is a typed Markup field spanning its brackets, never content; absent and empty labels remain distinct; leaf"
        },
        {
            "name": "Cite",
            "fields": [
                {
                    "name": "citations",
                    "type": "[Citation]",
                    "optional": false
                }
            ],
            "invariants": "one or more items in source order; every item has exactly one referent and one cite never mixes referent families; an inherited `[^label]` call is one item with a `footnote` referent whose id is the normalized label without the caret and with empty affixes; its items are scoped values, never children, so it is a leaf"
        },
        {
            "name": "DefinitionList",
            "fields": [
                {
                    "name": "definitions",
                    "type": "[Definition]",
                    "optional": false
                }
            ],
            "invariants": "non-empty ordered definitions; each association owns its term and bodies"
        },
        {
            "name": "Definition",
            "fields": [
                {
                    "name": "term",
                    "type": "[Markup]",
                    "optional": false
                },
                {
                    "name": "content",
                    "type": "[[Markup]]",
                    "optional": false
                },
                {
                    "name": "compact",
                    "type": "Bool",
                    "optional": false
                }
            ],
            "invariants": "inline term; non-empty outer content collection, each inner collection is one body of block content; compact is true iff no blank line separates the term and its first marker; visit term then bodies in source order"
        }
    ],
    "values": {
        "Destination": {
            "purpose": "A tagged value, not a node: it has no scope, children, anchor, or attributes, and a branch's fields exist only in that branch. Every Link and Embedded owns the url branch; the cross branch is the workspace address CrossLink and CrossEmbedded produce.",
            "branches": {
                "url": [
                    {
                        "name": "value",
                        "type": "String",
                        "optional": false
                    }
                ],
                "cross": [
                    {
                        "name": "path",
                        "type": "String",
                        "optional": false
                    },
                    {
                        "name": "anchor",
                        "type": "String",
                        "optional": true
                    }
                ]
            },
            "dump": "url(\"...\") or cross(path=\"...\",anchor=null)"
        },
        "CitationReferent": {
            "purpose": "A tagged value, not a node: it has no scope, and a branch's fields exist only in that branch. The bib branch is first produced by the citations module with P7; every referenced or inline footnote call produces the footnote branch, whose id names the Footnote in Document.footnotes with the equal id. The specimen branch names the first Specimen in Document.specimens with the equal non-null id; syntax production lands with P9b.",
            "branches": {
                "bib": [
                    {
                        "name": "key",
                        "type": "String",
                        "optional": false
                    },
                    {
                        "name": "mode",
                        "type": "BibMode",
                        "optional": false
                    }
                ],
                "footnote": [
                    {
                        "name": "id",
                        "type": "String",
                        "optional": false
                    }
                ],
                "specimen": [
                    {
                        "name": "id",
                        "type": "String",
                        "optional": false
                    }
                ]
            },
            "dump": "bib(key=\"...\",mode=normal) or footnote(id=\"...\") or specimen(id=\"...\")"
        },
        "Citation": {
            "purpose": "One item of a Cite: a scoped value, not a Markup kind, because it is written. It is reached only through Cite.citations, it receives a value callback from the walking visitor, and its affixes are non-null inline content, empty when absent.",
            "scoped": true,
            "fields": [
                {
                    "name": "referent",
                    "type": "CitationReferent",
                    "optional": false
                },
                {
                    "name": "prefix",
                    "type": "[Markup]",
                    "optional": false
                },
                {
                    "name": "suffix",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "dump": "Citation scope=L:C..L:C referent=... children=0, then a CitationPrefix and a CitationSuffix group"
        },
        "Footnote": {
            "purpose": "One element of Document.footnotes: a scoped value, not a Markup kind, because it is written. A referenced definition keeps its normalized label as id and its parsed block content. An inline footnote keeps its parsed inline body directly and receives inline-N, de-collided with -K against all authored ids, in scope-start order at document finalization. Both forms share Document.footnotes in scope-start order.",
            "scoped": true,
            "fields": [
                {
                    "name": "id",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "dump": "Footnote scope=L:C..L:C id=\"...\" children=N"
        },
        "OrderedListDelimiter": {
            "purpose": "The authored punctuation of an ordered marker: a period, parenthesis punctuation recording whether an opening parenthesis was authored, or the default marker form.",
            "scoped": false,
            "branches": [
                {
                    "name": "period",
                    "fields": []
                },
                {
                    "name": "parenthesis",
                    "fields": [
                        {
                            "name": "closed",
                            "type": "Bool",
                            "optional": false
                        }
                    ]
                },
                {
                    "name": "default",
                    "fields": []
                }
            ],
            "dump": "period, parenthesis(closed=true|false), or default"
        },
        "OrderedListVariant": {
            "purpose": "The authored numbering system of an ordered marker, with authored case carried by alphabetic and Roman variants.",
            "scoped": false,
            "branches": [
                {
                    "name": "decimal",
                    "fields": []
                },
                {
                    "name": "alpha",
                    "fields": [
                        {
                            "name": "lowercased",
                            "type": "Bool",
                            "optional": false
                        }
                    ]
                },
                {
                    "name": "roman",
                    "fields": [
                        {
                            "name": "lowercased",
                            "type": "Bool",
                            "optional": false
                        }
                    ]
                },
                {
                    "name": "default",
                    "fields": []
                }
            ],
            "dump": "decimal, alpha(lowercased=true|false), roman(lowercased=true|false), or default"
        },
        "Specimen": {
            "purpose": "One document-owned specimen definition: a scoped value, never Markup or a structural child. All definitions, including duplicates and anonymous definitions, remain in scope-start order. id is the authored label or null. start is an effective explicit counter reset or null for continuation; displayed numbers are derived, never stored. P9b produces this value from source.",
            "scoped": true,
            "fields": [
                {
                    "name": "id",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "start",
                    "type": "Int",
                    "optional": true
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "dump": "Specimen scope=L:C..L:C id=null start=null children=N"
        },
        "TableColumn": {
            "purpose": "One logical table column, located by its table; alignment and optional positive finite authored width share. Pipe tables produce relative=null.",
            "scoped": false,
            "fields": [
                {
                    "name": "alignment",
                    "type": "TableAlignment",
                    "optional": false
                },
                {
                    "name": "relative",
                    "type": "Double",
                    "optional": true
                }
            ],
            "dump": "alignment:relative within the compact columns array"
