                    "type": "PlacementMode",
                    "optional": false
                },
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "either mode; leaf"
        },
        {
            "name": "Emphasis",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "Strong",
