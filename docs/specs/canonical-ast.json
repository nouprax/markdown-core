            ],
            "invariants": "label is as written and identifier is the match key, exactly as on ReferenceDefinition; the node carries NO destination -- the destination is stated once, at the definition; form records which of the three spellings the source used, and all three resolve identically; inline content"
        },
        {
            "name": "ImageReference",
            "fields": [
                {
                    "name": "label",
                    "type": "String",
                    "optional": false
                },
                {
