{
    "schemaVersion": 1,
    "purpose": "The machine-readable, normative canonical AST contract. C, Swift, Kotlin, and TypeScript declare projections of this shape, and scripts/audit-ast-projections.mjs checks every projection plus the prose and debug-dump tables against this file. Formula is the only kind whose placement mode varies; placement for Code, CodeBlock, Directive, DirectiveBlock, and FormulaBlock is implied by the kind.",
    "prose": "docs/specs/canonical-ast.md",
    "dumpGrammar": "docs/specs/canonical-ast-dump.md",
    "walk": {
        "phases": ["entering", "exiting"],
        "order": "Depth first. A node enters, then its owned Markup-valued fields are visited in canonical field order with arrays retaining stored order, then the node exits. Relations remain named fields; the walk does not project them into generic children."
    },
    "enums": {
        "PlacementMode": ["embedded", "standalone"],
        "ListFlavor": ["bullet", "ordered"],
        "TableAlignment": ["none", "left", "center", "right"],
        "DirectiveAttribute": "a name/value pair of Strings"
    },
    "inheritedField": {
        "name": "scope",
        "type": "Scope",
        "optional": false
    },
    "kinds": [
        {
            "name": "Document",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "block content"
        },
        {
            "name": "BlockQuote",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "block content"
        },
        {
            "name": "Paragraph",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "Heading",
            "fields": [
                {
                    "name": "level",
                    "type": "Int",
                    "optional": false
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "`level` is 1 through 6; inline content"
        },
        {
            "name": "ThematicBreak",
            "fields": [],
            "invariants": "leaf"
        },
        {
            "name": "List",
            "fields": [
                {
                    "name": "flavor",
                    "type": "ListFlavor",
                    "optional": false
                },
                {
                    "name": "start",
                    "type": "Int",
                    "optional": true
                },
                {
                    "name": "tight",
                    "type": "Bool",
                    "optional": false
                },
                {
                    "name": "items",
                    "type": "[ListItem]",
                    "optional": false
                }
            ],
            "invariants": "`start` is non-null only for ordered lists"
        },
        {
            "name": "ListItem",
            "fields": [
                {
                    "name": "checked",
                    "type": "Bool",
                    "optional": true
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "`checked == null` means not a task item; block content"
        },
        {
            "name": "CodeBlock",
            "fields": [
                {
                    "name": "info",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "language",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "fenced",
                    "type": "Bool",
                    "optional": false
                },
                {
                    "name": "closed",
                    "type": "Bool",
                    "optional": false
                }
            ],
            "invariants": "mode is `standalone`; `info` is the complete raw info string; `language` is its first non-whitespace token; indented blocks have `fenced=false, closed=true`"
        },
        {
            "name": "HTMLBlock",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "raw HTML is preserved; a block that opens with `<!--` and whose end line holds only whitespace after the first `-->` is a `Comment`"
        },
        {
            "name": "FormulaBlock",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "mode is `standalone`"
        },
        {
            "name": "Table",
            "fields": [
                {
                    "name": "alignments",
                    "type": "[TableAlignment]",
                    "optional": false
                },
                {
                    "name": "header",
                    "type": "TableRow",
                    "optional": false
                },
                {
                    "name": "rows",
                    "type": "[TableRow]",
                    "optional": false
                }
            ],
            "invariants": "one alignment per column; header is non-optional"
        },
        {
            "name": "TableRow",
            "fields": [
                {
                    "name": "isHeader",
                    "type": "Bool",
                    "optional": false
                },
                {
                    "name": "cells",
                    "type": "[TableCell]",
                    "optional": false
                }
            ],
            "invariants": "`isHeader` is true only for `Table.header` and false for entries in `Table.rows`"
        },
        {
            "name": "TableCell",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "DirectiveBlock",
            "fields": [
                {
                    "name": "name",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "attributes",
                    "type": "[DirectiveAttribute]",
                    "optional": true
                },
                {
                    "name": "label",
                    "type": "DirectiveLabel",
                    "optional": true
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "attributes preserves first-occurrence source order with unique names; label is a node-valued field whose scope spans its brackets and is never part of content; content is block; an absent attribute container and an empty one remain distinct, as do an absent label and an empty one"
        },
        {
            "name": "DirectiveLabel",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content; the scope spans the brackets, so an empty label is still a place"
        },
        {
            "name": "FootnoteDefinition",
            "fields": [
                {
                    "name": "label",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "identifier",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "label is non-empty and as written; identifier KEEPS the leading `^`, so a footnote and a link definition of one name cannot collide; block content"
        },
        {
            "name": "Text",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "leaf"
        },
        {
            "name": "SoftBreak",
            "fields": [],
            "invariants": "leaf"
        },
        {
            "name": "LineBreak",
            "fields": [],
            "invariants": "leaf"
        },
        {
            "name": "Code",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "mode is `embedded`; leaf"
        },
        {
            "name": "HTML",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "raw HTML is preserved; an HTML comment token is a `Comment`; leaf"
        },
        {
            "name": "Comment",
            "fields": [
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "the one kind valid in both block and inline content, which the parent edge records; `literal` excludes the delimiters and keeps every byte between them; leaf"
        },
        {
            "name": "Formula",
            "fields": [
                {
                    "name": "mode",
                    "type": "PlacementMode",
                    "optional": false
                },
                {
                    "name": "literal",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "either mode; leaf"
        },
        {
            "name": "Emphasis",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "Strong",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "Strikethrough",
            "fields": [
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "inline content"
        },
        {
            "name": "Link",
            "fields": [
                {
                    "name": "dest",
                    "type": "Destination",
                    "optional": false
                },
                {
                    "name": "title",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "`dest` is the tagged `Destination` value and is never absent: `[a]()` and `[a](<>)` wrote one and wrote nothing in it, so it is `url(\"\")`; a reference occurrence answers the destination its definition stated, and an unresolved reference is the inherited literal text; every `Link` owns the `url` branch; absent and empty title remain distinct; inline content"
        },
        {
            "name": "Image",
            "fields": [
                {
                    "name": "dest",
                    "type": "Destination",
                    "optional": false
                },
                {
                    "name": "title",
                    "type": "String",
                    "optional": true
                },
                {
                    "name": "content",
                    "type": "[Markup]",
                    "optional": false
                }
            ],
            "invariants": "`dest` is the tagged `Destination` value and is never absent, for the reason `Link.dest` is not; every `Image` owns the `url` branch; absent and empty title remain distinct; content is parsed alt-text inline content"
        },
        {
            "name": "Directive",
            "fields": [
                {
                    "name": "name",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "attributes",
                    "type": "[DirectiveAttribute]",
                    "optional": true
                },
                {
                    "name": "label",
                    "type": "DirectiveLabel",
                    "optional": true
                }
            ],
            "invariants": "attributes preserves first-occurrence source order with unique names; label is a node-valued field whose scope spans its brackets and is never a child/content element; an absent attribute container and an empty one remain distinct, as do an absent label and an empty one"
        },
        {
            "name": "FootnoteReference",
            "fields": [
                {
                    "name": "label",
                    "type": "String",
                    "optional": false
                },
                {
                    "name": "identifier",
                    "type": "String",
                    "optional": false
                }
            ],
            "invariants": "label is non-empty and as written; identifier KEEPS the leading `^`; no form -- there is one footnote call syntax; leaf"
        }
    ],
    "values": {
        "Destination": {
            "purpose": "A tagged value, not a node: it has no scope, children, anchor, or attributes, and a branch's fields exist only in that branch. Every Link and Image owns the url branch; the cross branch is the workspace address a CrossLink produces once O1 lands.",
            "branches": {
                "url": [
                    {
                        "name": "value",
                        "type": "String",
                        "optional": false
                    }
                ],
                "cross": [
                    {
                        "name": "path",
                        "type": "String",
                        "optional": false
                    },
                    {
                        "name": "anchor",
                        "type": "String",
                        "optional": true
                    }
                ]
            },
            "dump": "url(\"...\") or cross(path=\"...\",anchor=null)"
        }
    }
}
