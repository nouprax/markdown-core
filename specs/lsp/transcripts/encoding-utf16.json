{
    "description": "A client that offers only encodings the parser does not count in gets UTF-16, which every client supports.",
    "messages": [
        {
            "client": {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "initialize",
                "params": {
                    "processId": null,
                    "rootUri": null,
                    "capabilities": {
                        "general": {
                            "positionEncodings": ["utf-32"]
                        }
                    }
                }
            }
        },
        {
            "server": {
                "jsonrpc": "2.0",
                "id": 1,
                "result": {
                    "capabilities": {
                        "positionEncoding": "utf-16",
                        "textDocumentSync": {
                            "openClose": true,
                            "change": 2
                        },
                        "completionProvider": {
                            "triggerCharacters": [
                                "\t",
                                "\n",
                                "\r",
                                " ",
                                "!",
                                "\"",
                                "#",
                                "'",
                                "(",
                                ",",
                                ".",
                                ":",
                                ";",
                                "<",
                                "=",
                                "@",
                                "[",
                                "^",
                                "`",
                                "{",
                                "~"
                            ]
                        }
                    },
                    "serverInfo": {
                        "name": "markdown-core"
                    }
                }
            }
        },
        {
            "client": {
                "jsonrpc": "2.0",
                "id": 2,
                "method": "shutdown"
            }
        },
        {
            "server": {
                "jsonrpc": "2.0",
                "id": 2,
                "result": null
            }
        },
        {
            "client": {
                "jsonrpc": "2.0",
                "method": "exit"
            }
        },
        {
            "exit": 0
        }
    ]
}
