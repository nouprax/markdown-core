{
    "name": "markdown-core",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": "26.8.1",
        "pnpm": "11.25.0"
    },
    "scripts": {
        "audit:ast-projections": "node scripts/audit/check-ast-projections.mjs",
        "audit:ci": "scripts/audit/check-ci-policy.sh",
        "audit:element-attach-order": "node scripts/audit/check-element-attach-order.mjs",
        "audit:finish-hook-shapes": "node scripts/audit/check-finish-hook-shapes.mjs",
        "audit:node-integrity-check": "node scripts/audit/check-node-integrity.mjs",
        "audit:parser-kind-record": "node scripts/audit/check-parser-kind-record.mjs",
        "audit:allocator-seam": "node scripts/audit/check-allocator-seam.mjs",
        "audit:element-special-chars": "node scripts/audit/check-element-special-chars.mjs",
        "audit:inline-sourcepos": "node scripts/audit/check-inline-sourcepos.mjs",
        "audit:packages": "scripts/audit/check-package-contents.sh",
        "audit:position-places": "node scripts/audit/check-position-places.mjs",
        "audit:reference-order": "node scripts/audit/check-reference-order-independence.mjs",
        "audit:repository": "scripts/audit/check-repository.sh",
        "audit:repository:clean": "scripts/audit/check-repository.sh --clean",
        "audit:scope-containment": "node scripts/audit/check-scope-containment.mjs",
        "audit:source-lists": "node scripts/audit/check-source-lists.mjs",
        "audit:surface": "scripts/audit/check-public-surface.sh",
        "audit:tests": "scripts/audit/check-test-topology.sh",
        "audit:toolchains": "scripts/audit/check-toolchain-versions.sh",
        "benchmark": "node scripts/benchmark/run.mjs",
        "benchmark:attributes": "node scripts/benchmark/measure-attributes.mjs",
        "build:c": "cmake --preset default && cmake --build --preset default --parallel",
        "build:swift": "swift build",
        "check:contracts": "node scripts/conformance/check-canonical-ast.mjs && scripts/tooling/run-gradle.sh :packages:kotlin-markdown-core:contracts:list-naming:compileKotlin",
        "check:element-inventory": "node --test scripts/shared/tests/element-inventory.test.mjs scripts/audit/tests/parser-boundaries.test.mjs",
        "check:gradle-model": "scripts/conformance/check-gradle-model.sh",
        "check:commonmark-parity": "node scripts/correctness/check-upstream-parity.mjs --oracle commonmark",
        "check:gfm-parity": "node scripts/correctness/check-upstream-parity.mjs --oracle gfm",
        "check:ins-parity": "node --test scripts/correctness/tests/ins-oracle.test.mjs && node scripts/correctness/check-ins-parity.mjs",
        "check:kotlin-consumers": "scripts/conformance/check-kotlin-consumers.sh",
        "check:mdast-parity": "node --test scripts/correctness/tests/mdast-oracle.test.mjs && node scripts/correctness/check-mdast-parity.mjs",
        "check:obsidian-parity": "node scripts/correctness/check-obsidian-parity.mjs",
        "check:oracle-parity": "pnpm run check:commonmark-parity && pnpm run check:gfm-parity && pnpm run check:mdast-parity && pnpm run check:obsidian-parity && pnpm run check:ins-parity && pnpm run check:pandoc-parity",
        "clean:kotlin-android-emulator": "scripts/tooling/run-gradle.sh :packages:kotlin-markdown-core:cleanManagedDevices",
        "conformance:c-host": "cmake --preset default && cmake --build --preset default --parallel && ctest --preset conformance",
        "conformance:es-node": "pnpm --dir packages/es-markdown-core run conformance",
        "conformance:kotlin-android-emulator": "scripts/shared/run-kotlin-android-emulator-tests.sh conformance",
        "conformance:kotlin-android-host": "scripts/tooling/run-gradle.sh :packages:kotlin-markdown-core:androidHostConformanceTest",
        "conformance:kotlin-jvm": "scripts/tooling/run-gradle.sh :packages:kotlin-markdown-core:jvmConformanceTest",
        "conformance:kotlin-linux-x64": "scripts/tooling/run-gradle.sh :packages:kotlin-markdown-core:linuxX64ConformanceTest",
        "conformance:kotlin-macos-arm64": "scripts/tooling/run-gradle.sh :packages:kotlin-markdown-core:macosArm64ConformanceTest",
        "conformance:swift-ios-simulator": "scripts/shared/run-swift-ios-tests.sh MarkdownCoreConformanceTests",
        "conformance:swift-macos": "CLANG_MODULE_CACHE_PATH=build/swift-module-cache swift test --disable-sandbox --filter '^MarkdownCoreConformanceTests\\.'",
        "format": "pnpm run format:c && pnpm run format:cmake && pnpm run format:swift && pnpm run format:kotlin && pnpm run format:es",
        "format:c": "scripts/tooling/format-c.sh",
        "format:c:check": "scripts/tooling/format-c.sh --check",
        "format:check": "pnpm run format:c:check && pnpm run format:cmake:check && pnpm run format:swift:check && pnpm run format:kotlin:check && pnpm run format:es:check",
        "format:cmake": "scripts/tooling/format-cmake.sh",
        "format:cmake:check": "scripts/tooling/format-cmake.sh --check",
        "format:es": "prettier --write .",
        "format:es:check": "prettier --check .",
        "format:kotlin": "scripts/tooling/run-gradle.sh ktlintFormat",
        "format:kotlin:check": "scripts/tooling/run-gradle.sh ktlintCheck",
        "format:swift": "scripts/tooling/format-swift.sh",
        "format:swift:check": "scripts/tooling/format-swift.sh --check",
        "fuzz:parity": "node --test scripts/correctness/tests/fuzz-scope.test.mjs && node scripts/correctness/fuzz-parity.mjs",
        "lint": "pnpm run lint:c && pnpm run lint:swift && pnpm run lint:kotlin && pnpm run lint:es",
        "lint:c": "scripts/tooling/lint-c.sh",
        "lint:es": "eslint .",
        "lint:kotlin": "scripts/tooling/run-gradle.sh ktlintCheck",
        "lint:swift": "scripts/tooling/lint-swift.sh",
        "release:check-version": "node scripts/release/check-version.mjs",
        "release:dry-run": "scripts/release/dry-run.sh",
        "test:c-host": "cmake --preset default && cmake --build --preset default --parallel && ctest --preset correctness",
        "test:es-browser": "node packages/es-markdown-core/scripts/run-tests.mjs --target browser",
        "test:es-node": "node packages/es-markdown-core/scripts/run-tests.mjs --target node",
        "test:kotlin-android-emulator": "scripts/shared/run-kotlin-android-emulator-tests.sh correctness",
        "test:kotlin-android-host": "scripts/tooling/run-gradle.sh :packages:kotlin-markdown-core:testAndroidHostTest",
        "test:kotlin-jvm": "scripts/tooling/run-gradle.sh :packages:kotlin-markdown-core:jvmTest",
        "test:kotlin-linux-x64": "scripts/tooling/run-gradle.sh :packages:kotlin-markdown-core:linuxX64Test",
        "test:kotlin-macos-arm64": "scripts/tooling/run-gradle.sh :packages:kotlin-markdown-core:macosArm64Test",
        "test:swift-ios-simulator": "scripts/shared/run-swift-ios-tests.sh MarkdownCoreTests",
        "test:swift-macos": "CLANG_MODULE_CACHE_PATH=build/swift-module-cache swift test --disable-sandbox --filter '^MarkdownCoreTests\\.' && CLANG_MODULE_CACHE_PATH=build/swift-module-cache swift test --disable-sandbox --package-path packages/swift-markdown-core/Tests/Consumer",
        "verify": "pnpm run format:check && pnpm run lint && pnpm run check:contracts && pnpm run check:gradle-model && pnpm run release:check-version && pnpm run audit:repository && pnpm run audit:ci && pnpm run audit:tests && pnpm run audit:surface && pnpm run check:element-inventory && pnpm run audit:element-special-chars && pnpm run audit:element-attach-order && pnpm run audit:finish-hook-shapes && pnpm run audit:parser-kind-record && pnpm run audit:allocator-seam && pnpm run audit:node-integrity-check && pnpm run audit:source-lists && pnpm run audit:ast-projections && pnpm run audit:packages",
        "check:pandoc-parity": "node --test scripts/correctness/tests/pandoc-oracle.test.mjs scripts/correctness/tests/pandoc-compositions.test.mjs && node scripts/correctness/check-pandoc-parity.mjs",
        "probe:pandoc-composition": "node --test scripts/correctness/tests/pandoc-compositions.test.mjs && node scripts/correctness/check-pandoc-compositions.mjs"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@quartz-community/remark-obsidian": "0.2.4",
        "eslint": "10.0.1",
        "markdown-it": "14.2.0",
        "markdown-it-ins": "4.0.0",
        "prettier": "3.9.5",
        "remark-directive": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-parse": "^11.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.63.0",
        "unified": "^11.0.5",
        "yaml": "2.9.0"
    }
}
